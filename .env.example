# ---------------------------------------------------------------------------
# YESIR DESIGN — environment variables
# Copy to .env.local for development. NEXT_PUBLIC_* values are inlined at
# BUILD time: rebuild after changing them.
# ---------------------------------------------------------------------------

# Public site URL (canonical URLs, sitemap, hreflang, Open Graph). Set it to your custom
# domain. On Vercel it defaults to the project's production domain when left empty.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.dz
# Set to "false" to block all crawlers. Vercel preview deployments are blocked automatically.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Contact channels — a channel left empty is simply not displayed.
# WhatsApp number in international format, digits only (e.g. 2136XXXXXXXX).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Phone number as it should be displayed/dialled (e.g. +213 6XX XX XX XX).
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# Legal entity & address (only shown / added to structured data when set).
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_STREET=
NEXT_PUBLIC_BUSINESS_CITY=
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
NEXT_PUBLIC_BUSINESS_REGION=

# Social profiles (optional).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TIKTOK_URL=

# ---------------------------------------------------------------------------
# Tracking (optional). Vercel Web Analytics & Speed Insights need no variable:
# enable them in the Vercel dashboard (project > Analytics / Speed Insights).
# The two tools below set cookies, so they only load after the visitor accepts
# the consent banner (which appears automatically when one of them is set).
# ---------------------------------------------------------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Meta (Facebook/Instagram) Pixel ID, digits only
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Lead delivery (server-side only). Configure AT LEAST ONE channel, otherwise
# the forms honestly report that sending is unavailable.
# ---------------------------------------------------------------------------

# 1) Webhook (n8n, Make, Zapier…): receives {"type":"lead.created","lead":{…}}
LEADS_WEBHOOK_URL=
# Optional: HMAC-SHA256 signature sent in the "x-yesir-signature: sha256=…" header.
LEADS_WEBHOOK_SECRET=

# 2) Supabase (table created by supabase/migrations/0001_leads.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=leads

# 3) Email notification via Resend (https://resend.com)
RESEND_API_KEY=
LEADS_EMAIL_TO=
# Must be a sender on a domain verified in Resend, e.g. "YESIR DESIGN <site@your-domain.dz>"
LEADS_EMAIL_FROM=
