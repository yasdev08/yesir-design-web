# Public site URL (canonical URLs, Open Graph, sitemap). Required in production.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.dz
# WhatsApp number that receives orders — international format, digits only (e.g. 2136XXXXXXXX).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional: Google Apps Script web-app URL that appends each order to a Google Sheet.
# Leave empty to disable (orders still go to WhatsApp).
GOOGLE_SHEETS_WEBHOOK_URL=
